generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum Branch {
  HO
  BP
  LB
}

enum DocStatus {
  DRAFT
  PENDING_ACK
  PENDING_CORRECTIVE_APPROVAL
  ATTACHED_PENDING
  WITHDRAWN
  PENDING_MR
  CLOSED
}

enum CheckResult {
  CONFORM
  CAR_MAJOR
  CAR_MINOR
  PAR
  NA
}

model User {
  id           String          @id @default(cuid())
  username     String          @unique
  passwordHash String
  name         String
  role         Role            @default(USER)
  createdAt    DateTime        @default(now())
  plans        AuditPlan[]
  documents    AuditDocument[]
}

model AuditPlan {
  id           String   @id @default(cuid())
  title        String
  fileName     String
  storedName   String
  sizeBytes    Int
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Department {
  id        String          @id @default(cuid())
  code      String
  name      String
  branch    Branch
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  documents AuditDocument[]
}

model AuditDocument {
  id                  String          @id @default(cuid())
  documentNo          String          @unique
  auditorName         String
  departmentId        String
  department          Department      @relation(fields: [departmentId], references: [id])
  standards           String          @default("[]")
  nonconformitySource String          @default("")
  dueDate             String          @default("")
  status              DocStatus       @default(DRAFT)
  auditorSignName     String          @default("")
  auditeeSignName     String          @default("")
  createdById         String
  createdBy           User            @relation(fields: [createdById], references: [id])
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  submittedAt         DateTime?
  checklist           ChecklistItem[]
}

model ChecklistItem {
  id         String        @id @default(cuid())
  documentId String
  document   AuditDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  question   String
  evidence   String        @default("")
  result     CheckResult   @default(CONFORM)
  sortOrder  Int           @default(0)
}
